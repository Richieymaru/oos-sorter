# Copy to .env and fill in. Never commit .env.
# Setup:  npm install     then     node --env-file=.env sort-oos.mjs   (Node 20.6+)

SHOP_DOMAIN=your-store.myshopify.com

# Dev Dashboard app > Settings > Credentials.
# The script exchanges these for a 24h token on every run.
CLIENT_ID=your_client_id
CLIENT_SECRET=your_client_secret

# Only if you have a static token (legacy custom app, or an offline token from
# the authorization code grant). Takes priority over CLIENT_ID/SECRET.
# ADMIN_TOKEN=

# Empty (or "all") = auto-discover and sort every collection in the store.
# Or list specific handles, comma-separated: frontpage,sale,new-arrivals
COLLECTION_HANDLES=

# Pin to what check-setup.mjs reports (currently 2026-07)
SHOPIFY_API_VERSION=2026-07

# ---- Features (each independent; default: only sort on) ----
FEATURE_SORT=true      # push sold-out products to the bottom / last page
FEATURE_NOTIFY=false   # email a daily digest of newly sold-out products
FEATURE_DRAFT=false    # set sold-out products to Draft (hidden store-wide)

# ---- Email (only needed when FEATURE_NOTIFY=true) ----
# GMAIL_APP_PASSWORD is a 16-char Gmail App Password (Google account needs
# 2-step verification), NOT your normal login password.
NOTIFY_EMAIL=you@example.com
GMAIL_USER=your.sender@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Set by the cron, not by hand:
#   SEND_DIGEST=true  -> this run sends the accumulated daily digest (the ~4pm run)

# ---- Sort tuning (optional) ----
PIN_TAG=pin-top        # products with this tag stay at the front, never drafted
IGNORE_TAG=oos-ignore  # products with this tag are never pushed down or drafted

# Safe default: log the plan, write nothing. Set to false to act.
DRY_RUN=true

# ---- Vercel-hosted control panel + reliable trigger (set these in Vercel) ----
# PANEL_PASSWORD  — password to open the settings page
# RUN_TOKEN       — secret that guards /api/run (the reliable cron endpoint).
#                   A free cron service pings:
#                     https://<app>.vercel.app/api/run?token=RUN_TOKEN        every 5 min
#                     https://<app>.vercel.app/api/run?token=RUN_TOKEN&digest=1  daily at 4pm for the digest
